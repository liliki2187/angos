  "visual_lock": {
    "must_keep": [
      "chief editor dispatch sign-off desk",
      "left task dossier, center dice pool tray, right review sheet",
      "deep navy editorial workbench",
      "fresh warm ivory printed paper",
      "red-orange deadline and sign-off accents",
      "restrained cyan tracking and support accents",
      "halftone dots, crop marks, red-cyan print misregistration, high-end micro-pixel print grain",
      "CTA as an in-world sign-off stamp action"
    ],
    "must_avoid": [
      "flat SaaS dashboard",
      "generic web buttons",
      "old newspaper",
      "yellowed archive paper",
      "dirty stains",
      "broken or torn paper",
      "sepia parchment",
      "tea stains",
      "realistic office desk photo",
      "photographic noise",
      "low resolution 8-bit UI",
      "baked dynamic text",
      "baked fake task names",
      "baked fake probability numbers",
      "baked fake buttons",
      "fake tooltip"
    ]
  },
  "integration_rules": {
    "no_baked_dynamic_text": true,
    "no_fake_numbers": true,
    "no_fake_buttons": true,
    "no_fake_tooltips": true,
    "visual_contract_first": true,
    "godot_dynamic_layer_owns": [
      "task titles",
      "task brief text",
      "staff names",
      "staff roles",
      "dice face labels",
      "selected count",
      "week and remaining day text",
      "success or threshold rate",
      "risk labels",
      "blocking reasons",
      "CTA labels",
      "button states",
      "hover, pressed, selected, disabled, focus and loading feedback"
    ],
    "overflow_policy": {
      "single_line": "trim_ellipsis",
      "multi_line": "wrap_then_trim",
      "button_label": "trim_ellipsis",
      "staff_name": "trim_ellipsis",
      "dice_label": "fixed_short_token",
      "blocking_reason": "review_sheet_or_tooltip_not_cta_label"
    },
    "fallback_policy": "Existing gd_project/Assets/ui/angus_packaging/dispatch assets and StyleBoxFlat dispatch controls are fallback only. Acceptance screenshots require assetized components."
  },
  "qa_cases": [
    {"id": "no_staff", "checks": ["selected slots empty", "candidate cards visible", "CTA disabled", "review sheet shows no-staff blocking reason"]},
    {"id": "one_staff_low_rate", "checks": ["one occupied slot", "candidate positions stable", "review sheet shows low rate and missing coverage"]},
    {"id": "two_staff_changed_rate", "checks": ["two occupied slots", "rate changes in review sheet only", "candidate grid does not reorder after selection"]},
    {"id": "three_staff_full", "checks": ["3/3 selected badge", "new candidate click enters blocked_full feedback", "no automatic replacement"]},
    {"id": "days_insufficient", "checks": ["CTA disabled", "action_scope shows remaining days issue", "button does not look clickable"]},
    {"id": "potential_points_insufficient", "checks": ["review gap explains missing relevant dice faces", "candidate card highlights low fit"]},
    {"id": "support_item_selected", "checks": ["support slot is visually separate from staff slot", "review sheet summarizes support as counted"]},
    {"id": "temporary_informant", "checks": ["temporary informant appears as staff candidate and occupies staff capacity"]},
    {"id": "candidate_hover", "checks": ["hover does not resize grid", "full six-face dice net appears if inline mode is compact"]},
    {"id": "cta_pressed_confirm_pending", "checks": ["stamp-down pressed frame visible", "review sheet still owns irreversible action scope"]},
    {"id": "cta_loading_stamped", "checks": ["loading frame visible", "stamped feedback visible", "no full result screen appears early"]},
    {"id": "return_region_preserves_selection", "checks": ["back tab returns to region board", "selected region and task remain selected"]},
    {"id": "long_title", "checks": ["left task title wraps or trims inside title slot", "right summary stays short and does not repeat long title"]},
    {"id": "long_failure_text", "checks": ["left failure_short trims before bottom fold", "right failure or blocking slot shows short version only"]},
    {"id": "deadline_long_digits", "checks": ["current remaining days, deadline remaining days and post-dispatch remaining days remain distinct"]},
    {"id": "top_pool_two_digit", "checks": ["top staff pool availability and pressure fit separate slots without entering right halftone no-text area"]},
    {"id": "support_item_unavailable", "checks": ["support slot disabled frame is visible", "reason appears in review blocking slot, not inside support card title"]}
  ],
