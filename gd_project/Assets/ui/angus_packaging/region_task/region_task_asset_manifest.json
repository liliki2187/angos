{
  "id": "region_task_board_assetized_v1",
  "version": 1,
  "status": "production_pipeline_spec",
  "target_view": "weekly_run.explore.region",
  "canvas_size": [1920, 1080],
  "safe_viewports": [[1920, 1080], [1600, 900], [1366, 768]],
  "visual_lock": {
    "source_asset": "gd_project/Assets/ui/angus_packaging/region_task/region-task-board-clean-pixel-v2.png",
    "artboard_v3_source_asset": "gd_project/Assets/ui/angus_packaging/region_task/artboard_v3/source-user-approved-reference.png",
    "must_keep": [
      "current region task board visual direction",
      "deep navy editorial map-wall base",
      "central map low-poly paper material",
      "red-orange route and deadline accents",
      "restrained cyan tracking accents",
      "fresh warm ivory printed paper",
      "halftone dots, crop marks, red-cyan misregistration, high-end micro-pixel print grain"
    ],
    "must_avoid": [
      "new visual direction",
      "new palette",
      "flat SaaS dashboard",
      "generic web buttons",
      "old newspaper",
      "yellowed archive paper",
      "sepia parchment",
      "realistic old map",
      "photographic noise",
      "baked text",
      "baked fake pins",
      "baked fake task labels"
    ]
  },
  "integration_rules": {
    "no_baked_dynamic_text": true,
    "no_fake_numbers": true,
    "no_fake_pins": true,
    "no_fake_buttons": true,
    "visual_lock_first": true,
    "state_aliases": {
      "default": "normal for controls that use default as the first atlas frame",
      "normal": "default for controls that use normal as the first atlas frame"
    },
    "overflow_policy": {
      "single_line": "trim_ellipsis",
      "multi_line": "wrap_then_trim",
      "button_label": "trim_ellipsis",
      "disabled_reason": "right_detail_blocking_reason_or_tooltip_not_button_label"
    },
    "godot_dynamic_layer_owns": [
      "task names",
      "node names",
      "task metadata",
      "deadline countdowns",
      "button labels",
      "hover, selected, pressed, disabled and loading semantics",
      "hotspots and feedback"
    ],
    "fallback_policy": "Legacy region-task-board-clean-pixel-v2.png and StyleBoxFlat region_task_v2 styles are fallback only. Acceptance screenshots require assetized components."
  },
  "qa_cases": [
    {"id": "default_selected_task", "checks": ["left task card selected", "matching map pin selected", "right detail populated", "CTA enabled"]},
    {"id": "long_title", "checks": ["task card title trims inside title rect", "right detail title wraps to two lines without crossing no-text rects"]},
    {"id": "two_digit_deadline", "checks": ["deadline status fits status rect", "red deadline visual does not overlap task text"]},
    {"id": "assigned_task", "checks": ["assigned card state visible", "assigned pin state visible", "CTA blocked or reroute copy appears outside button label"]},
    {"id": "disabled_cta", "checks": ["CTA disabled frame visible", "disabled reason appears in right detail blocking slot or tooltip, not inside CTA label"]},
    {"id": "hover_and_pressed", "checks": ["pin hover label has collision gap", "task card hover does not resize list", "CTA pressed frame moves visually down by pressed_offset"]},
    {"id": "advance_day_misclick_guard", "checks": ["advance day sits in global schedule strip, not under task CTA", "advance day has confirming frame", "task_dispatch_cta and advance_day_button hit rects do not share a visual group"]},
    {"id": "empty_region", "checks": ["map remains visually anchored", "task list empty state uses runtime text only", "no baked fake task labels visible"]},
    {"id": "full_region", "checks": ["five hotspots remain clickable", "pin labels avoid each other", "left task list scrolls without stretching cards"]}
  ],
  "layout_slots": [
    {
      "id": "top_hud_strip",
      "rect": [32, 24, 1856, 72],
      "role": "low weight global status strip"
    },
    {
