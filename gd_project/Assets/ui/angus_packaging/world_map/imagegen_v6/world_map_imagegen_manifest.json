  "art_direction": {
    "source_of_truth": "design/art-direction/angus-visual-style-guide.md",
    "reference_translation": "docs/plans/world-map-imagegen-v6/reference-translation.md",
    "must_keep": [
      "clean bright ivory paper UI objects",
      "deep navy editorial engineering board",
      "faceted low-poly paper world map",
      "modern supernatural weekly magazine identity",
      "controlled red-orange anomaly/deadline marks",
      "restrained cyan tracking/signal marks",
      "low-noise blank content areas for Godot-rendered text"
    ],
    "must_avoid": [
      "old newspaper",
      "yellowed archive",
      "parchment",
      "historical case file",
      "photographic paper noise",
      "dirty paper speckles",
      "cyberpunk hologram",
      "glass SaaS panels",
      "generic mobile game buttons",
      "baked Chinese text",
      "baked numbers",
      "fake pins",
      "fake task states",
      "fake clickable buttons"
    ]
  },
  "integration_rules": {
    "no_baked_dynamic_text": true,
    "no_fake_numbers": true,
    "no_fake_pins": true,
    "no_fake_buttons": true,
    "no_programmatic_style_simulation": true,
    "godot_dynamic_layer_owns": [
      "region names",
      "task counts",
      "remaining days",
      "lock reasons",
      "button labels",
      "hover, selected, disabled semantics",
      "hotspots and feedback"
    ]
  },
