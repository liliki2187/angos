  "review_gates": [
    {
      "id": "art_gate",
      "owner": "angus_art_director",
      "checks": [
        "Matches Angus modern supernatural weekly style, not old archive.",
        "Pixel texture is intentional 2-4px block clusters, halftone, and red-cyan misregistration.",
        "Character stickers match the four-character benchmark if present.",
        "No baked dynamic text, fake numbers, fake pins, or generic UI chrome."
      ]
    },
    {
      "id": "ui_gate",
      "owner": "ui_designer",
      "checks": [
        "Every bitmap component has final size, Godot node type, state mapping, and safe zones.",
        "Resizable assets have nine-patch margins and quiet centers.",
        "TextureButton assets include normal, hover, pressed, disabled, and selected/focus variants where needed."
      ]
    },
    {
      "id": "ux_gate",
      "owner": "ux_laoge",
      "checks": [
        "Player can tell selected, available, locked, deadline, and chain states at 1920x1080, 1600x900, and 1366x768.",
        "Visual anchors, hot rectangles, and feedback anchors align.",
        "The right folder is selected-region detail, not a clickable task list.",
        "The main CTA remains the visual endpoint."
      ]
    }
