{
  "id": "world_map_imagegen_v5",
  "version": 1,
  "status": "production_pipeline_spec",
  "target_view": "weekly_run.explore.world",
  "canvas_size": [1920, 1080],
  "safe_viewports": [[1920, 1080], [1600, 900], [1366, 768]],
  "art_direction": {
    "source_of_truth": "design/art-direction/angus-visual-style-guide.md",
    "primary_style_refs": [
      "docs/screenshots/2026-06-07-global-channel-style-board/05-global-channel-style-board-reference-clean-modern-pixel.png",
      "docs/screenshots/2026-06-07-global-channel-style-board/07-global-channel-full-interface-style-draft-flat-magazine-ui.png",
      "docs/screenshots/2026-06-11-world-map-ui-style-sheet/03-world-map-ui-style-sheet-v3-textless-modern-pixel.png",
      "docs/screenshots/2026-06-11-world-map-ui-style-sheet/04-world-map-ui-style-sheet-v4-micro-pixel-compare.png"
    ],
    "character_style_ref": "角色设计风格规范-AI包/reference/01-原始基准图.png",
    "must_keep": [
      "modern editorial supernatural weekly magazine",
      "deep navy base, vivid red-orange anomaly, warm paper, restrained cyan",
      "printed matter materiality, crop marks, halftone, red-cyan misregistration",
      "intentional 2-4px pixel particle clusters and crisp graphic edges",
      "blank low-noise safe areas for Godot-rendered text"
    ],
    "must_avoid": [
      "old newspaper, yellowed archive, parchment, historical case file",
      "warm wood desk, coffee office, lamp-lit nostalgia",
      "8-bit, FC, Pico-8, low-resolution voxel characters",
      "photographic noise, dirty paper speckles, mold, muddy gray detail",
      "cyberpunk hologram, glass SaaS panels, generic mobile game buttons",
      "baked Chinese text, baked numbers, baked real task states, fake pins"
    ]
  },
  "integration_rules": {
    "no_baked_dynamic_text": true,
    "no_fake_numbers": true,
    "no_fake_pins": true,
    "no_fake_buttons": true,
    "no_programmatic_style_simulation": true,
    "godot_dynamic_layer_owns": [
      "region names",
      "task counts",
      "remaining days",
      "lock reasons",
      "button labels",
      "hover, selected, disabled semantics",
      "hotspots and feedback"
    ],
    "fallback_policy": "StyleBoxFlat and procedural drawing are debug fallback only and must not appear in acceptance screenshots."
  },
  "layout_slots": [
    {
      "id": "top_status",
      "rect": [28, 22, 1370, 76],
      "role": "global status ticket",
      "text_safe_rects": [
