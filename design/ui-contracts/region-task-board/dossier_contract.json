  "forbidden": [
    "approved_stamp_in_shell",
    "risk_red_border_in_neutral_section_plate",
    "runtime_text_in_raster",
    "cta_label_or_icon_baked_into_shell",
    "external_shadow_in_interactive_cta_alpha",
    "direct_crop_from_fullscreen_mock"
  ]
