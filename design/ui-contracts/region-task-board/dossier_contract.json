{
  "id": "region_task_dossier_v2",
  "version": 3,
  "runtime_rect": [1484, 96, 412, 960],
  "zones": {
    "header": [1508, 120, 364, 104],
    "summary": [1508, 244, 364, 304],
    "metadata": [1508, 568, 364, 140],
    "risk_and_chain": [1508, 728, 364, 144],
    "primary_cta": [1512, 916, 356, 112]
  },
  "data_fields": [
    "payload.node_title",
    "payload.region_node_summary",
    "payload.region_node_meta",
    "payload.region_node_deadline",
    "payload.region_node_chain",
    "payload.region_action_hint",
    "payload.dispatch_open_enabled",
    "payload.dispatch_open_text"
  ],
  "states": ["empty", "selected", "disabled", "ready"],
  "asset_classes": {
    "shell": "rt_dossier_shell",
    "section_plate": "rt_dossier_section_plate",
    "status_badge": "rt_status_badge_atlas",
    "primary_cta": "rt_dispatch_cta_mother"
  },
  "asset_policy": {
    "shell_implementation": "fixed_alpha_master",
    "shell_export_scale": 2,
    "shell_alpha_padding": [10, 10, 10, 10],
    "section_implementation": "neutral_nine_patch",
    "external_shadow_owner": "Godot",
    "risk_border_owner": "Godot runtime state",
    "fixed_approved_stamp_forbidden": true
  },
  "text_policy": {
    "summary_scroll": false,
    "summary_default_visible_lines": [7, 8],
    "summary_pressure_max_lines": 9,
    "summary_overflow": "open_full_summary_layer",
    "title_max_lines": 2,
    "cta_runtime_text": true,
    "overflow_must_not_cover_cta": true
  },
  "interaction": {
    "primary_cta": "open_dispatch",
    "cta_fixed_to_bottom": true,
    "cta_disabled_without_selection": true
